{
  "concurrency": 8,
  "timeout": 3600,
  "results_dir": ".",
  "overwrite": false,
  "completion_notifications": false,
  "configs": {
    "claude-opus-5.5": {
      "model": "anthropic/claude-opus-5.5",
      "concurrency": 1
    },
    "gpt-6-sol": {
      "model": "openai/gpt-6-sol",
      "concurrency": 1
    },
    "gpt-6-luna": {
      "model": "openai/gpt-6-luna",
      "concurrency": 8
    },
    "deepseek-v4.1-flash": {
      "model": "deepseek/deepseek-v4.1-flash",
      "provider": {
        "only": [
          "DeepInfra"
        ],
        "allow_fallbacks": false
      },
      "concurrency": 8
    }
  },
  "crunchbench": {
    "model_defaults": {
      "reasoning_effort": "high",
      "max_tokens": null,
      "temperature": null,
      "prompt_cache": true,
      "structured_output": "auto"
    },
    "context_sizes": [
      8000,
      16000,
      32000,
      64000,
      128000,
      256000,
      512000
    ]
  }
}
